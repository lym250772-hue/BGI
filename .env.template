# BGI Agent Configuration
# Copy this file to .env and fill in your values
#
# =============================================================================
# 注意: .env 文件包含敏感信息，已被 .gitignore 排除，不会提交到 Git
# =============================================================================

# --- LLM API ---
BGI_LLM_API_KEY=your_api_key_here
BGI_LLM_API_BASE=https://api.deepseek.com/v1
BGI_LLM_MODEL=deepseek-chat

# --- Telegram ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- 平台登录 Cookie（JSON 数组格式，可留空使用文件兜底）---
# 获取方式: 浏览器登录后，用 EditThisCookie 等扩展导出 JSON
# 也可在 data/raw/{platform}_cookies.json 放置 Cookie 文件（已 gitignore）
BGI_WEIBO_COOKIES=
BGI_TIEBA_COOKIES=
BGI_ZHIHU_COOKIES=
BGI_XIAOHONGSHU_COOKIES=
BGI_DOUYIN_COOKIES=
